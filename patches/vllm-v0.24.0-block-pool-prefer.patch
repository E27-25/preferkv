 logger = init_logger(__name__)
 
+# ---------------------------------------------------------------------------
+# preferkv PREFER patch (persistent-frequency eviction for the v1 block pool).
+#
+# Bind-mounted over vllm/v1/core/block_pool.py with the preferkv package mounted
+# read-only at /preferkv_pkg, so the eviction score is computed by the SHIPPED
+# preferkv library (same package as the SGLang runs). vLLM's APC is a flat
+# block-hash map (no radix tree), so the branchiness term is inert here; the
+# active ingredient is persistent frequency + recency tiebreak. Victim
+# selection scans the free queue at eviction time (reference implementation;
+# the library core uses a lazy heap for O(log n)).
+# ---------------------------------------------------------------------------
+import math as _pk_math
+import sys as _pk_sys
+
+if "/preferkv_pkg" not in _pk_sys.path:
+    _pk_sys.path.insert(0, "/preferkv_pkg")
+try:
+    from preferkv.persist import PersistentFrequency as _PkPersist
+
+    print("[preferkv-vllm] using shipped preferkv library (persistent frequency)",
+          flush=True)
+except Exception as _pk_e:  # pragma: no cover - keeps the server bootable
+    print(f"[preferkv-vllm] lib import failed ({_pk_e!r}); using inline fallback",
+          flush=True)
+
+    class _PkPersist:  # identical minimal fallback
+        def __init__(self, cap: int = 1_000_000):
+            self._c: dict = {}
+            self.cap = cap
+
+        def bump(self, k):
+            n = self._c.get(k, 0) + 1
+            self._c[k] = n
+            if len(self._c) > self.cap:
+                self._c = {kk: v >> 1 for kk, v in self._c.items() if v > 1}
+            return n
+
+        def get(self, k):
+            return self._c.get(k, 0)
+
+# Process-wide so counts survive block eviction (the whole point).
+_PK_PERSIST = _PkPersist()
+
+
+def _pk_score(block) -> float:
+    """PREFER priority of a cached block: log1p(persistent frequency)."""
+    return _pk_math.log1p(_PK_PERSIST.get(block.block_hash))
+
 
