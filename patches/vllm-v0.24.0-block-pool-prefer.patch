+    def _prefer_popleft_n(self, n: int) -> list[KVCacheBlock]:
+        """PREFER victim selection over the free queue.
+
+        Never-hashed blocks are used first (no eviction cost; stock vLLM keeps
+        them at the head for the same reason). Cached blocks are then evicted in
+        ascending PREFER score = log1p(persistent frequency); queue position
+        (recency order, head = least recent) breaks ties, which is exactly the
+        LRU tiebreak of the library's policy.
+        """
+        free = self.free_block_queue.get_all_free_blocks()
+        if len(free) < n:  # defensive: caller already checked the count
+            return self.free_block_queue.popleft_n(n)
+        chosen: list[KVCacheBlock] = []
+        hashless = [b for b in free if b.block_hash is None]
+        chosen.extend(hashless[:n])
+        need = n - len(chosen)
+        if need > 0:
+            hashed = [(b, i) for i, b in enumerate(free) if b.block_hash is not None]
+            hashed.sort(key=lambda t: (_pk_score(t[0]), t[1]))
+            chosen.extend(b for b, _ in hashed[:need])
+        for b in chosen:
+            self.free_block_queue.remove(b)
+        return chosen
+
